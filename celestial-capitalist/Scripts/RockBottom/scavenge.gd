func _ready():
	lootTurnout.hide()
	reset()
	for item in lootableList.get_children():
		lootableList.remove_child(item)
		item.queue_free()
	for item in lootBox.get_children():
		lootBox.remove_child(item)
		item.queue_free()
	genLootables()

func _input(event):
	if event.is_action_pressed("debug"):
		print("scavengeActive: " + str(scavengeActive))

#region generate lootables
## Generates lootables. [br]
## 1. Reset lootables. [br]
## 2. Decide how many lootables to generate. [br]
## - 0 =< balance <= 10 | 4 lootables [br]
## - 10 < balance <= 100 | 3-4 lootables [br]
## - 100 < balance <= 300 | 2-3 lootables [br]
## - 300 < balance <= 700 | 1-2 lootables [br]
## - 700 < balance | 1 lootables [br]
## 3. Pick which lootables can generate based on balance (see [member lvl1Lootables] - [member lvl4Lootables]). If balance > 700 generate any lootable. [br]
## 4. Create a matching [TextureButton].
func genLootables():
	#1.
	for item in lootableList.get_children():
		lootableList.remove_child(item)
		item.queue_free()
	
	if lootButton.pressed.is_connected(loot):
		lootButton.pressed.disconnect(self.loot)
	lootButtonContainer.hide()
	lootableDesc.targetText = ""
	lootableDesc.fillText()
	
	#2.
	## How many lootables will be generated
	var lootableCount : int
	if ledger.money >= 0 and ledger.money <= 10:
		lootableCount = 4
	elif ledger.money > 10 and ledger.money <= 100:
		lootableCount = randi_range(3,4)
	elif ledger.money > 100 and ledger.money <= 300:
		lootableCount = randi_range(2,3)
	elif ledger.money > 300 and ledger.money <= 700:
		lootableCount = randi_range(1,2)
	else:
		lootableCount = 1

	## Keeps track of how many lootables have been generated and is also used to assign lootable [TextureButton]s an index.
	var generatedIndex = 0
	#3.
	for i in lootableCount:
		## The randomly generated lootable id.
		var randomLootable : String
		if ledger.money >= 0 and ledger.money <= 10:
			lootableCount = randi_range(4,5)
			randomLootable = lvl1Lootables.pick_random()
		elif ledger.money > 10 and ledger.money <= 100:
			lootableCount = randi_range(3,4)
			randomLootable = lvl2Lootables.pick_random()
		elif ledger.money > 100 and ledger.money <= 300:
			lootableCount = randi_range(2,3)
			randomLootable = lvl3Lootables.pick_random()
		elif ledger.money > 300 and ledger.money <= 700:
			lootableCount = randi_range(1,2)
			randomLootable = lvl4Lootables.pick_random()
		else:
			lootableCount = 1
			randomLootable = allLootables.keys().pick_random()

		#4.
		## Used in construction of [TextureButton]s for each lootable.
		var lootableButton = TextureButton.new()
		lootableButton.texture_normal = allLootables[randomLootable][4]
		lootableButton.name = allLootables[randomLootable][0]
		lootableButton.set_script(lootableButtonScript)
		lootableButton.index = generatedIndex
		lootableButton.pressed.connect(identifyTarget.bind(randomLootable, generatedIndex, allLootables[randomLootable][0]))
		lootableList.add_child(lootableButton)
		lootableList.get_child(generatedIndex).name = allLootables[randomLootable][0]
		generatedIndex += 1

## Writes the selected lootable's name to window title.
func identifyTarget(lootableID, listIndex, displayName):
	lootableDesc.targetText = displayName
	lootableDesc.fillText()
	if lootButton.pressed.is_connected(loot):
		lootButton.pressed.disconnect(self.loot)
	lootButton.pressed.connect(loot.bind(lootableID, listIndex))
	lootButtonContainer.show()

## Generates new lootables when the time is up.
func _on_loot_refresh_refresh(theValue: Variant) -> void:
	if theValue == 0.0:
		genLootables()
#endregion

#region game management
## Removes a lootable. Called after looting.
func removeLootable(listIndex):
	## Increments during removal cycle.
	var count = 0
	for obj in lootableList.get_children():
		if count == listIndex:
			lootableList.remove_child(obj)
			obj.queue_free()
		count += 1

## Sets up the loot minigame from a lootable id. 
## Hides unnecessary aspects of the screen and shows minigame parts. 
## Resets the minigame and updates terminal text.
func loot(lootableID, listIndex):
	scavengeActive = true
	
	directive.hide()
	$pickLootable/lootableDesc.hide()
	lootButtonContainer.hide()
	lootResult.show()
	lootTurnout.hide()
	$lootResult/Terminal.show()
	lootableList.lootableListHidden = true
	minigameWindow.show()
	
	terminalText.show()
	terminalText.targetText = "> System: Cut into the lootable as accurately as possible over the guideline. Cutting outside the lines will damage loot inside."
	terminalText.fillText()
	
	reference.reset()
	drawn.reset()
	drawn.score = 0
	reference.texture = referenceTextures[allLootables[lootableID][3]]
	reference.writePixelsToArray()
	reference.countPixels()
	drawn.drawnPixels = []
	drawn.drawingOn = true
	timer.difficultyIndex = allLootables[lootableID][3]
	timer.startTimer()
	
	storedLootable = lootableID
	removeLootable(listIndex)
	

## Resets the game and loot results.
func reset():
	refreshExplanation.targetText = ""
	refreshExplanation.fillText()
	
	if lootButton.pressed.is_connected(loot):
		lootButton.pressed.disconnect(self.loot)
		
	directive.show()
	lootableDesc.show()
	lootableDesc.text = ""
	terminalText.targetText = ""
	terminalText.fillText()
	terminal.hide()
	
	lootButtonContainer.hide()
	lootResult.hide()
	lootTurnout.hide()
	reference.reset()
	
	drawn.reset()
	drawn.score = 0
	drawn.drawnPixels = []
	drawn.drawingOn = true
	
	$pickLootable.show()

## Ends the minigame
func _on_timer_end_game() -> void:
	drawn.drawingOn = false
	drawn.reset()
	timer.value = 0
	minigameWindow.hide()
	
	lootTurnout.show()
	if (drawn.score < 0):
		drawn.score = 0
	reference.pixelCount = reference.pixelCount / 2
	
	terminalText.targetText = "> System: You scored " + str(drawn.score) + "/" + str(reference.pixelCount) + "\n Select loot to keep. Exit menu at any time to discard undesired items."
	terminalText.fillText()
	
	itemDesc.itemSelected = false
	lootTurnout.show()
	genLoot()
	
	drawn.score = 0
	drawn.drawnPixels = []
	reference.pixelCount = 0
	reference.reset()
	
	scavengeActive = false
#endregion
	
#region loot
## Called from a loot [TextureButton]. Removes the loot and adds to inventory.
func takeLoot(item, listIndex):
	if ((listIndex <= lootBox.get_child_count() - 1)):
		if (lootBox.get_child(listIndex) != null):
			## The [TextureButton] from which the loot is taken.
			var obj = lootBox.get_child(listIndex)
			inventory.addItem(item)
			lootBox.remove_child(obj)
			obj.queue_free()
			if (lootBox.get_child_count() == 0):
				reset()
				scavengeOpen = false
			takeButtonContainer.hide()
			itemDesc.itemSelected = false

## Generates loot from the [member storedLootable]. [br]
## [br]
## [b]Process: [/b] [br]
## 0. Reset the [LootBox] [br]
## 1. Generate roll based on a bell curve from 0 to largest weight value in loot table, with standard deviation (largest weight / 1.25).
## I was too lazy to make a curve resource myself so I just cannibalized and butchered a bell curve in half. [br]
## 2. Set any generated roll above max weight to max weight - prevents out of bounds index errors. 
## Negative roll values are fine - this just means all items in the pool are possible and they should be as rare as necessary. [br]
## 3. If weight of item is higher than roll, add to an array. [br]
## 4. Pick random item with even chances from said array, add to loot results. [br]
## 5. Generate quality per each item - percentage scored * random lootable tier, rounded to the nearest whole.
## Deviate [member qualityPreDeviation] - larger deviation range to lower qualities. Set zero or negative qualities to one. [br]
## 6. Generate a name. [br]
## 7. Generate a [TextureButton] for each loot item.
func genLoot():
	#0.
	var currentLootable = allLootables[storedLootable]
	for item in lootBox.get_children():
		lootBox.remove_child(item)
		item.queue_free()
	if takeButton.pressed.is_connected(takeLoot):
		takeButton.pressed.disconnect(self.takeLoot)
	takeButtonContainer.hide()

	## A deep duplicate of the lootable's loot table.
	var tempLootTable = currentLootable[5].duplicate_deep()
	## Keeps track of how many loot items have been generated and is also used to assign loot [TextureButton]s an index.
	var generatedIndex = 0
	# 1.
	## A roll based on a bell curve from 0 to largest weight value in loot table, with standard deviation (largest weight / 1.25).
	var roll = randfn(tempLootTable.values().max(), tempLootTable.values().max()/1.25)
	# 2.
	if (roll > tempLootTable.values().max()):
		roll = tempLootTable.values().max()
	## List of items with weight higher than the roll.
	var tempLootTableResults = []
	# 3.
	for item in tempLootTable:
		if roll <= tempLootTable[item] && generatedIndex < currentLootable[2]:
			tempLootTableResults.append(item)
	for i in currentLootable[2]:
		# 4.
		## The final base item picked from [member tempLootTableResults]
		var finalItem = tempLootTableResults.pick_random()
		# 5.
		## The score from the game as a percentage
		var scorePercentage = snapped((drawn.score / reference.pixelCount), 0.01)
		## Percentage scored * random lootable tier, rounded to the nearest whole.
		var qualityPreDeviation = snapped((allLootables[storedLootable][1] * scorePercentage), 1)
		## Final item quality.
		var itemQual = randi_range(qualityPreDeviation - 15, qualityPreDeviation + 5)
		if (itemQual <= 0):
			itemQual = 1
		# 6.
		## Randomly generated display name.
		var displayName = prefixes.pick_random() + " " + finalItem[0]
		
		# 7.
		## Used in construction of [TextureButton]s for each loot item.
		var takeableLootButton = TextureButton.new()
		takeableLootButton.texture_normal = finalItem[-1]
		takeableLootButton.texture_pressed = finalItem[-2]
		takeableLootButton.name = finalItem[0]
		takeableLootButton.set_script(takeableLootButtonScript)
		takeableLootButton.index = generatedIndex
		var assembledItem = assembleItem(itemQual, finalItem, displayName)
		takeableLootButton.pressed.connect(generateInfo.bind(itemDesc, assembledItem, takeableLootButton))
		lootBox.add_child(takeableLootButton)
		lootBox.get_child(takeableLootButton.get_index()).name = finalItem[0]
		generatedIndex += 1

## Overrides [method InventoryHelper.generateInfo]. Updates the [ItemDesc] and take button to show. Connects the take button to the selected item.
func generateInfo(desc, item, selectedLoot := TextureButton.new()):
	terminalText.hide()
	super.generateInfo(desc, item)
	itemDesc.itemSelected = true
	if takeButton.pressed.is_connected(takeLoot):
		takeButton.pressed.disconnect(self.takeLoot)
	if (selectedLoot.get_index() != null):
		takeButton.pressed.connect(takeLoot.bind(item, selectedLoot.get_index()))
	takeButtonContainer.show()

#region screen
func onButton():
	lootResult.hide()
	terminalText.targetText = ""
	terminalText.fillText()
	reset()
	scavengeOpen = not scavengeOpen
	if scavengeOpen == true:
		lootableList.lootableListHidden = false
		lootableDesc.text = ""
		lootableDesc.show()
		directive.targetText = "Lootables Identified"
		directive.fillText()
		refreshExplanation.targetText = "Until new lootables"
		refreshExplanation.fillText()
		directive.show()

func _process(_delta):
	if scavengeOpen == false:
		self.hide()
	else:
		self.show()

