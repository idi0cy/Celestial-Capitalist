## Lootables that appear at 300<balance<=700 dollars
var lvl4Lootables : Array[String] = ["Discarded Package", "Heavy Briefcase"]
#endregion

#region lootable methods
## Method for creating new lootables. Used instead of just assigning an array to operate on each lootable on ready. 
## Appends items to [member allLootables] using their name as [code]key:lootable[/code]. [br]
## [br]
## [b]Lootable Indexes:[/b] [br]
## 0 name, [br]
## 1 lootQuality acts as a base quality for loot to deviate from, [br]
## 2 containerSize is the amount of loot items, [br]
## 3 referenceImage is the index of the reference image to use in [member referenceTextures], [br]
## 4 texture, [br]
## 5 lootTable. [br]
## [br]
## [b]Loot Table Format: [/b][code]item: weight[/code] [br]
## Higher weight = more frequent. Random loot is generated by grabbing random number skewed towards highest number in weight pool.
## Items with weights above generated number are added to an array, after which each loot slot randomly picks from the list with equal chances.
func newLootable(
	lootableName:String, lootQuality:float, containerSize:int,
	referenceImage:int, texture:Texture2D, lootTable:Dictionary):
	var lootable = [lootableName, lootQuality, containerSize, referenceImage, texture, lootTable]
	allLootables[lootableName] = lootable
	return lootable
#endregion

